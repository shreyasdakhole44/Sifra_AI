# SIFRA AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API keys and credentials.

# MongoDB Connection (Local or Atlas Cluster)
MONGODB_URI=mongodb://localhost:27017/sifra_ai

# Groq API Key (Required for AI 7-Section Analysis and MCQ Quiz Generation)
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Secret Key for User Session Tokens
JWT_SECRET=sifra_ai_super_secret_jwt_key_oil_india_2026

# Twilio Credentials (Optional: For Automated High-Risk SMS Alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# SendGrid API Key (Optional: For Automated High-Risk Email Alerts)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=safety@oilindia.in
